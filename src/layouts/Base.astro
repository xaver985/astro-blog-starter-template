---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title: string;
	description: string;
	image?: string;
	lang?: string;
	type?: 'website' | 'article';
}

const { title, description, image, lang = 'en', type } = Astro.props;
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={title} description={description} image={image} type={type} />
		<slot name="head" />
	</head>
	<body>
		<a class="skip-link" href="#content">Skip to content</a>
		<Header />
		<main id="content">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<style>
	.skip-link {
		position: absolute;
		left: 1rem;
		top: -3rem;
		z-index: 10;
		padding: 0.5rem 0.9rem;
		border-radius: 4px;
		background: var(--heading);
		color: var(--bg);
		font-size: 0.9rem;
		text-decoration: none;
	}

	.skip-link:focus {
		top: 1rem;
	}
</style>
