---
import type { CollectionEntry } from 'astro:content';
import Base from './Base.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Giscus from '../components/giscus.astro';

type Neighbour = { id: string; title: string } | undefined;

type Props = CollectionEntry<'blog'>['data'] & {
	minutes?: number;
	newer?: Neighbour;
	older?: Neighbour;
};

const { title, description, pubDate, updatedDate, heroImage, lang, minutes, newer, older } =
	Astro.props;
---

<Base title={title} description={description} image={heroImage} lang={lang} type="article">
	<article>
		<header class="post-header">
			<p class="meta">
				<FormattedDate date={pubDate} />
				{minutes && <span aria-hidden="true">·</span>}
				{minutes && <span>{minutes} min read</span>}
			</p>
			<h1 class="page-title">{title}</h1>
			{description && <p class="page-intro">{description}</p>}
			{
				updatedDate && (
					<p class="updated">
						Updated <FormattedDate date={updatedDate} />
					</p>
				)
			}
		</header>

		{
			heroImage && (
				<figure class="hero">
					<img src={heroImage} alt="" width={1020} height={510} />
				</figure>
			)
		}

		<div class="prose">
			<slot />
		</div>
	</article>

	{
		(newer || older) && (
			<nav class="pager" aria-label="More posts">
				<div>
					{older && (
						<a href={`/blog/${older.id}/`}>
							<span class="label">Previous</span>
							<span class="pager-title">{older.title}</span>
						</a>
					)}
				</div>
				<div class="next">
					{newer && (
						<a href={`/blog/${newer.id}/`}>
							<span class="label">Next</span>
							<span class="pager-title">{newer.title}</span>
						</a>
					)}
				</div>
			</nav>
		)
	}

	<section class="comments" aria-label="Comments">
		<Giscus />
	</section>
</Base>

<style>
	article,
	.pager,
	.comments {
		max-width: var(--measure);
		margin-left: auto;
		margin-right: auto;
	}

	.post-header {
		margin-bottom: 2.75rem;
	}

	.meta {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 1rem;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.updated {
		margin: 1rem 0 0;
		color: var(--muted);
		font-size: 0.88rem;
		font-style: italic;
	}

	.hero {
		margin: 0 0 2.75rem;
	}

	.hero img {
		display: block;
		width: 100%;
		border-radius: 4px;
	}

	.pager {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: 1.5rem;
		margin-top: 4rem;
		padding-top: 2rem;
		border-top: 1px solid var(--rule);
	}

	.pager a {
		display: block;
		text-decoration: none;
	}

	.pager .label {
		margin-bottom: 0.3rem;
	}

	.pager-title {
		display: block;
		color: var(--heading);
		font-family: var(--font-serif);
		font-size: 1.05rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.pager a:hover .pager-title {
		color: var(--accent);
	}

	.next {
		text-align: right;
	}

	.comments {
		margin-top: 3.5rem;
	}

	@media (max-width: 560px) {
		.pager {
			grid-template-columns: 1fr;
		}

		.next {
			text-align: left;
		}
	}
</style>
