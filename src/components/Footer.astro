---
const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		<p>&copy; {year} Lewis Wang</p>
		<nav aria-label="Elsewhere">
			<a href="mailto:hello@lewisw.net">Email</a>
			<a href="https://github.com/xaver985" rel="me noreferrer" target="_blank">GitHub</a>
			<a href="/rss.xml">RSS</a>
		</nav>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--rule);
		color: var(--muted);
		font-size: 0.88rem;
	}

	.inner {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 1.5rem;
		max-width: calc(var(--wide) + 2.5rem);
		margin: 0 auto;
		padding: 2rem 1.25rem 2.5rem;
	}

	p {
		margin: 0;
	}

	nav {
		display: flex;
		gap: 1.25rem;
	}

	a {
		color: var(--muted);
		text-decoration: none;
	}

	a:hover {
		color: var(--heading);
	}
</style>
