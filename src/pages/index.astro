---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { getPosts } from '../lib/posts';

const recent = (await getPosts()).slice(0, 5);
---

<Base title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<section class="intro" aria-labelledby="page-title">
		<p class="label">lewisw.net</p>
		<h1 id="page-title" class="page-title">Lewis Wang</h1>
		<p class="page-intro">Interested in domains, email, networking and self-hosting.</p>

		<div class="about">
			<p>Hello, I'm Lewis. I usually go by lewisw online.</p>
			<p>
				I'm interested in domains, email, Linux, networking and self-hosting, mostly through
				running and maintaining my own services. I also have a passion for the English language
				and Chinese culture.
			</p>
		</div>

		<p class="contact">
			<a href="mailto:hello@lewisw.net">hello@lewisw.net</a>
			<span aria-hidden="true">·</span>
			<a href="https://github.com/xaver985" target="_blank" rel="me noreferrer">GitHub</a>
			<span aria-hidden="true">·</span>
			<a href="/about">More about me</a>
		</p>
	</section>

	<section class="recent" aria-labelledby="recent-title">
		<div class="section-head">
			<h2 id="recent-title" class="label">Recent writing</h2>
			<a href="/blog">All posts →</a>
		</div>
		<PostList posts={recent} showYear />
	</section>
</Base>

<style>
	.intro {
		max-width: var(--measure);
	}

	.about {
		margin-top: 2rem;
		font-family: var(--font-serif);
		font-size: 1.1rem;
		line-height: 1.8;
	}

	.about p {
		margin: 0;
	}

	.about p + p {
		margin-top: 1rem;
	}

	.contact {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		margin: 1.75rem 0 0;
		color: var(--muted);
		font-size: 0.95rem;
	}

	.recent {
		margin-top: 4.5rem;
		padding-top: 2rem;
		border-top: 1px solid var(--rule);
	}

	.section-head {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		margin-bottom: 0.5rem;
	}

	.section-head .label {
		margin: 0;
	}

	.section-head a {
		font-size: 0.9rem;
		text-decoration: none;
	}

	.section-head a:hover {
		text-decoration: underline;
	}
</style>
