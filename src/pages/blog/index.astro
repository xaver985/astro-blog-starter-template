---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
import { getPosts, type Post } from '../../lib/posts';

const posts = await getPosts();

// Group posts by year, newest year first.
const years = new Map<number, Post[]>();
for (const post of posts) {
	const year = post.data.pubDate.getUTCFullYear();
	years.set(year, [...(years.get(year) ?? []), post]);
}
---

<Base title={`Writing · ${SITE_TITLE}`} description="Notes on domains, email, self-hosting and other things I've tried.">
	<header class="head">
		<h1 class="page-title">Writing</h1>
		<p class="page-intro">Notes on things I've tried, problems I've solved and decisions I've made.</p>
	</header>

	{
		[...years].map(([year, list]) => (
			<section class="year" aria-labelledby={`y${year}`}>
				<h2 id={`y${year}`} class="label">{year}</h2>
				<PostList posts={list} />
			</section>
		))
	}
</Base>

<style>
	.head {
		margin-bottom: 3rem;
	}

	.year + .year {
		margin-top: 3rem;
	}

	.year .label {
		padding-bottom: 0.6rem;
		margin-bottom: 0;
		border-bottom: 1px solid var(--rule);
	}
</style>
