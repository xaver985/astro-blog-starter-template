---
// src/pages/links.astro
import Base from '../layouts/Base.astro';
import { SITE_TITLE } from '../consts';

const links = [
	{
		name: 'Kiyoi',
		url: 'https://blog.kiyoi.xyz/',
		desc: 'Kiyoi blog',
	},
	{
		name: 'Paji',
		url: 'https://blog.paji.uk/',
		avatar: 'https://blog.paji.uk/images/avatar.png',
		desc: 'Paji blog',
	},
];
---

<Base title={`Links · ${SITE_TITLE}`} description="My friends">
	<header class="head">
		<h1 class="page-title">Links</h1>
		<p class="page-intro">Contact me if you want your site listed here</p>
	</header>

	<ul class="links">
		{
			links.map((link) => (
				<li>
					<a href={link.url} target="_blank" rel="noopener">
						{link.avatar ? (
							<img src={link.avatar} alt="" width="44" height="44" loading="lazy" />
						) : (
							<span class="avatar" aria-hidden="true">
								{link.name.charAt(0)}
							</span>
						)}
						<span class="info">
							<span class="name">{link.name}</span>
							<span class="desc">{link.desc}</span>
						</span>
						<span class="host">{new URL(link.url).hostname}</span>
					</a>
				</li>
			))
		}
	</ul>
</Base>

<style>
	.head {
		margin-bottom: 2.5rem;
	}

	.links {
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--rule);
	}

	li {
		border-bottom: 1px solid var(--rule);
	}

	a {
		display: flex;
		align-items: center;
		gap: 1rem;
		padding: 1rem 0.25rem;
		color: inherit;
		text-decoration: none;
	}

	img,
	.avatar {
		flex-shrink: 0;
		width: 44px;
		height: 44px;
		border-radius: 50%;
		background: var(--surface);
		object-fit: cover;
	}

	.avatar {
		display: grid;
		place-items: center;
		background: var(--surface);
		color: var(--accent);
		font-family: var(--font-serif);
		font-size: 1.15rem;
		font-weight: 600;
	}

	.info {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-width: 0;
	}

	.name {
		color: var(--heading);
		font-family: var(--font-serif);
		font-size: 1.12rem;
		font-weight: 600;
	}

	.desc,
	.host {
		color: var(--muted);
		font-size: 0.9rem;
	}

	a:hover .name {
		color: var(--accent);
	}

	@media (max-width: 480px) {
		.host {
			display: none;
		}
	}
</style>
